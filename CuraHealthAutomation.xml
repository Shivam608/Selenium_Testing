<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd" >

<suite name="Cura Health Login Automation">
    <listeners>
        <listener class-name="Practice_Assignments.Selenium_Rest_NG.Selenium.Utils.TestListener_CuraHealth"/>
    </listeners>
    <test name="CuraHealth">

        <!-- Define parameter at test level -->
        <parameter name="isBrowserClosed" value="true"/>

        <classes>
            <class name="Practice_Assignments.Selenium_Rest_NG.Selenium.CuraHealthCase_Assignment_1">
                <methods>
                    <include name="selectBookAppointment"/>
                    <include name="LogIn"/>
                    <include name="createAppointment">
                        <parameter name="Value_1" value="Tokyo CURA Healthcare Center"/>
                    </include>
                </methods>
            </class>

        </classes>
    </test>
</suite>